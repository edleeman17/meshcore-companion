# Copy to ./deploy.env (git-ignored) and edit. Read by bridge/deploy.sh and pwa/deploy.sh.
HOST=raspberrypi                       # ssh host of the machine with Bluetooth
RADIO_ADDRESS=AA:BB:CC:DD:EE:FF        # Bluetooth: from bluetoothctl --timeout 15 scan on | grep MeshCore
# RADIO_SERIAL=/dev/ttyACM0            # USB instead: the radio's port (ls /dev/serial/by-id/), USB companion firmware
VAPID_SUBJECT=mailto:admin@example.com # contact for push services
PWA_DEST=/srv/meshcore-pwa             # where pwa/deploy.sh copies the static site (local or host:path)
# BACKUP_DIR=/mnt/backups/meshcore
# DISCOVER_NAMES="mytown myvillage mycounty"
