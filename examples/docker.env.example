# .env next to docker-compose.yml (cp examples/docker.env.example .env).
# The radio's USB port on the host. Prefer the by-id path: ls /dev/serial/by-id/
RADIO_DEVICE=/dev/serial/by-id/usb-…
# Group that owns the port on the host, if it isn't 20 (Debian/Ubuntu/Raspberry Pi OS).
# Find it with: stat -c %g "$(readlink -f /dev/serial/by-id/usb-…)"   (Arch is usually 14, Fedora 18)
# RADIO_GID=20
# RADIO_BAUD=115200
# VAPID_SUBJECT=mailto:you@example.com   # push keys are generated on first start
# DISCOVER_NAMES=mytown mycounty mytopic
# QRZ_USERNAME=
# QRZ_PASSWORD=
