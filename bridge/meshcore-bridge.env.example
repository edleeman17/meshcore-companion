# ~/.config/meshcore-bridge.env on the bridge host (deploy.sh creates it for you).
RADIO_ADDRESS=AA:BB:CC:DD:EE:FF        # Bluetooth: radio BLE MAC (bluetoothctl devices | grep MeshCore)
# RADIO_SERIAL=/dev/serial/by-id/usb-…   # USB instead (USB companion firmware); wins over RADIO_ADDRESS
# RADIO_BAUD=115200
# RADIO_PIN=                           # leave unset when paired with pair.sh (recommended)
VAPID_PRIVATE_KEY=                     # Web Push keys; deploy.sh generates these
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# DISCOVER_NAMES=mytown mycounty mytopic   # extra hashtag names to test for channel discovery
# BACKUP_DIR=/mnt/backups/meshcore         # where backup.sh puts nightly DB copies
# QRZ_USERNAME=                            # optional: QRZ.com login, shows names for callsigns in node names
# QRZ_PASSWORD=                            #   (free account: name/town/country; XML subscription adds photo/grid)
